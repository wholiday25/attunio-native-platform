import { View, Text, TouchableOpacity, TextInput, Image, ScrollView, StyleSheet } from 'react-native';
"use client"

import { useState } from "react"


export function ProgressTrackerScreen({ onBack }: { onBack: () => void }) {
  const [selectedPeriod, setSelectedPeriod] = useState<"week" | "month" | "quarter">("month")

  const milestones = [
    {
      title: "Connected Wearable",
      date: "Jan 15, 2025",
      completed: true,
      description: "Started tracking biomarkers",
    },
    {
      title: "Baseline Established",
      date: "Feb 2, 2025",
      completed: true,
      description: "2 weeks of consistent data",
    },
    {
      title: "First Lab Results",
      date: "Feb 10, 2025",
      completed: true,
      description: "Ferritin & Vitamin D tested",
    },
    {
      title: "Clinician Consultation",
      date: "Feb 18, 2025",
      completed: false,
      description: "Scheduled for this week",
    },
    {
      title: "Treatment Plan Started",
      date: "Coming soon",
      completed: false,
      description: "Based on data insights",
    },
  ]

  const improvements = [
    { metric: "HRV", from: 38, to: 42, unit: "ms", change: "+10.5%", positive: true },
    { metric: "Sleep Efficiency", from: 68, to: 72, unit: "%", change: "+5.9%", positive: true },
    { metric: "REM Sleep", from: 12, to: 14, unit: "%", change: "+16.7%", positive: true },
    { metric: "Sleep Latency", from: 52, to: 45, unit: "min", change: "-13.5%", positive: true },
  ]

  return (
    <View className="min-h-screen bg-white pb-24">
      <View className="border-b border-slate-200 px-4 sm:px-6 lg:px-8 pt-6 pb-8 max-w-6xl mx-auto">
        <TouchableOpacity onPress={onBack} className="flex items-center gap-2 text-slate-600 hover:text-slate-900 mb-4">
          <svg className="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <Textath strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M15 19l-7-7 7-7" />
          </svg>
          Back
        </TouchableOpacity>

        <Text className="text-xs uppercase tracking-wider text-slate-500 mb-2">(Your Journey)</Text>
        <Text className="text-3xl sm:text-4xl font-bold text-slate-900 mb-2 tracking-tight">Track Your Progress</Text>
        <Text className="text-slate-600 text-sm sm:text-base">See how your ADHD biomarkers have improved over time</Text>
      </View>

      <View className="px-4 sm:px-6 lg:px-8 py-6 space-y-8 max-w-6xl mx-auto">
        {/* Milestones Timeline */}
        <View>
          <Text className="text-2xl font-bold text-slate-900 mb-6">Your Milestones</Text>
          <View className="space-y-4">
            {milestones.map((milestone, index) => (
              <View key={index} className="flex gap-4">
                <View className="flex flex-col items-center">
                  <View
                    className={`w-10 h-10 rounded-full flex items-center justify-center ${
                      milestone.completed ? "bg-teal-600" : "bg-slate-200"
                    }`}
                  >
                    {milestone.completed ? (
                      <svg className="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <Textath strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M5 13l4 4L19 7" />
                      </svg>
                    ) : (
                      <View className="w-3 h-3 rounded-full bg-slate-400" />
                    )}
                  </View>
                  {index < milestones.length - 1 && (
                    <View className={`w-0.5 h-16 ${milestone.completed ? "bg-teal-600" : "bg-slate-200"}`} />
                  )}
                </View>
                <View className="flex-1 pb-6">
                  <View className="flex items-center gap-3 mb-2">
                    <Text className="text-lg font-semibold text-slate-900">{milestone.title}</Text>
                    {!milestone.completed && milestone.date !== "Coming soon" && (
                      <Badge className="bg-teal-100 text-teal-700 border-0">Upcoming</Badge>
                    )}
                  </View>
                  <Text className="text-sm text-slate-600 mb-1">{milestone.description}</Text>
                  <Text className="text-sm text-slate-500">{milestone.date}</Text>
                </View>
              </View>
            ))}
          </View>
        </View>

        {/* Improvements */}
        <View>
          <Text className="text-2xl font-bold text-slate-900 mb-6">Biomarker Improvements</Text>
          <View className="grid grid-cols-1 md:grid-cols-2 gap-4">
            {improvements.map((item) => (
              <View key={item.metric} className="bg-white rounded-2xl p-6 border border-slate-200">
                <View className="flex items-start justify-between mb-4">
                  <Text className="text-lg font-semibold text-slate-900">{item.metric}</Text>
                  <Badge className="bg-emerald-100 text-emerald-700 border-0">{item.change}</Badge>
                </View>
                <View className="flex items-center gap-6">
                  <View>
                    <Text className="text-sm text-slate-600 mb-1">From</Text>
                    <Text className="text-2xl font-bold text-slate-400">
                      {item.from} <Text className="text-sm">{item.unit}</Text>
                    </Text>
                  </View>
                  <svg className="w-6 h-6 text-teal-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <Textath strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M14 5l7 7m0 0l-7 7m7-7H3" />
                  </svg>
                  <View>
                    <Text className="text-sm text-slate-600 mb-1">To</Text>
                    <Text className="text-2xl font-bold text-teal-600">
                      {item.to} <Text className="text-sm">{item.unit}</Text>
                    </Text>
                  </View>
                </View>
              </View>
            ))}
          </View>
        </View>
      </View>
    </View>
  )
