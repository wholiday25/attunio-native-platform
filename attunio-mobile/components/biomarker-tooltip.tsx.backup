import { View, Text, TouchableOpacity, TextInput, Image, ScrollView, StyleSheet } from 'react-native';
import type React from "react"

import { InfoCircledIcon } from "@radix-ui/react-icons"

const biomarkerTooltips = {
  hrv: "Heart Rate Variability measures the variation in time between heartbeats. Higher HRV (60+ ms) indicates better stress management and autonomic nervous system health.",

  waso: "Wake After Sleep Onset is the total time you spend awake after initially falling asleep. Lower WASO (<30 min) means more consolidated, restorative sleep.",

  remSleep:
    "REM (Rapid Eye Movement) sleep is when most dreaming occurs. Adults need 20-25% REM sleep for memory consolidation and emotional regulation. ADHD is often associated with reduced REM.",

  deepSleep:
    "Deep sleep (slow-wave sleep) is the most restorative sleep stage. Adults need 15-20% for physical recovery and hormone regulation. Too little can affect focus.",

  sleepEfficiency:
    "Sleep Efficiency is the percentage of time in bed actually spent sleeping. Good: >85%, Fair: 75-85%, Poor: <75%. Low efficiency may indicate sleep disturbances common in ADHD.",

  sleepLatency:
    "Sleep Latency is how long it takes to fall asleep. Normal: 10-20 min, Long: >30 min. ADHD often causes delayed sleep onset due to racing thoughts.",

  restingHeartRate:
    "Your heart rate when fully at rest. Normal adult: 60-100 bpm. Lower is generally better (unless <50). Elevated RHR can indicate stress or poor cardiovascular fitness.",

  respiratoryRate:
    "How many breaths you take per minute. Normal: 12-16 breaths. Elevated rate (>18) often indicates anxiety or stress, which can affect ADHD symptoms.",

  focusScore:
    "Your Focus Score combines sleep quality, heart rate variability, activity level, and stress markers to predict your ability to concentrate. Based on research showing 89% accuracy in ADHD prediction.",

  adhdRiskScore:
    "This score uses validated biomarkers to assess ADHD symptom severity. Based on peer-reviewed research using wearable data with 85-89% clinical accuracy.",

  activeMinutes:
    "Time spent in moderate to vigorous physical activity. Target: 30+ min/day. Regular exercise significantly improves ADHD symptoms by increasing dopamine.",

  sedentaryTime:
    "Time spent sitting or inactive. High sedentary time (>8 hrs) worsens ADHD symptoms. Aim to break up long sitting periods with movement.",

  stepVariability:
    "How consistent your daily steps are. High variability (>40% coefficient of variation) may indicate inconsistent routines, common in ADHD.",

  glucose:
    "Blood glucose levels affect brain function and focus. Rapid spikes and crashes can worsen ADHD symptoms. Stable glucose (70-100 mg/dL) supports sustained attention.",
} as const

type BiomarkerTerm = keyof typeof biomarkerTooltips

interface BiomarkerTooltipProps {
  term: BiomarkerTerm
  children: React.ReactNode
}

export function BiomarkerTooltip({ term, children }: BiomarkerTooltipProps) {
  return (
    <TooltipProvider delayDuration={200}>
      <Tooltip>
        <TooltipTrigger asChild>
          <View className="flex items-center gap-2 cursor-help">
            {children}
            <InfoCircledIcon className="w-4 h-4 text-slate-400 hover:text-teal-600 transition-colors" />
          </View>
        </TooltipTrigger>
        <TooltipContent
          side="top"
          className="max-w-xs p-4 text-sm leading-relaxed bg-slate-900 text-white border-slate-700"
          sideOffset={5}
        >
          <Text>{biomarkerTooltips[term]}</Text>
        </TooltipContent>
      </Tooltip>
    </TooltipProvider>
  )
}
