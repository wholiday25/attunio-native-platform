import { View, Text, TouchableOpacity, TextInput, Image, ScrollView, StyleSheet } from 'react-native';
"use client"



import { useState, useEffect } from "react"

export function MedicationTrackingScreen() {
  const [activeTab, setActiveTab] = useState<"log" | "titration" | "history">("log")
  const [expandedDose, setExpandedDose] = useState<string | null>(null)
  const [loggedToday, setLoggedToday] = useState(false)
  const [medications, setMedications] = useState<any[]>([])
  const [medicationLogs, setMedicationLogs] = useState<any[]>([])
  const [titrationHistory, setTitrationHistory] = useState<any[]>([])
  const [isLoading, setIsLoading] = useState(true)
  const [selectedMood, setSelectedMood] = useState<string>("")
  const [selectedSideEffects, setSelectedSideEffects] = useState<string[]>([])
  const [notes, setNotes] = useState<string>("")

  // Load medication history from API
  useEffect(() => {
    async function loadMedicationData() {
      try {
        const response = await fetch('/api/medication/history?days=90');
        
        if (response.ok) {
          const data = await response.json();
          console.log('[Medication] ✅ Loaded medication logs:', data);
          setMedicationLogs(data.logs || []);
          
          // Check if logged today
          const today = new Date().toISOString().split('T')[0];
          const loggedToday = data.logs?.some((log: any) => log.timestamp.startsWith(today));
          setLoggedToday(loggedToday);
        } else {
          console.log('[Medication] ⚠️ Using mock data (API unavailable)');
          setMedicationLogs([]);
        }
      } catch (error) {
        console.error('[Medication] Error loading data:', error);
        setMedicationLogs([]);
      } finally {
        setIsLoading(false);
      }
    }
    
    loadMedicationData();
  }, []);

  // Handle logging medication dose
  const handleLogDose = async () => {
    try {
      const response = await fetch('/api/medication/log', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          medicationName: mockMedications[0].name,
          dosage: mockMedications[0].dose,
          timestamp: new Date().toISOString(),
          mood: selectedMood || undefined,
          sideEffects: selectedSideEffects.length > 0 ? selectedSideEffects : undefined,
          notes: notes || undefined,
        }),
      });

      if (response.ok) {
        console.log('[Medication] ✅ Dose logged successfully');
        setLoggedToday(true);
        
        // Reload medication history
        const historyResponse = await fetch('/api/medication/history?days=90');
        if (historyResponse.ok) {
          const data = await historyResponse.json();
          setMedicationLogs(data.logs || []);
        }
        
        // Reset form
        setSelectedMood("");
        setSelectedSideEffects([]);
        setNotes("");
      } else {
        console.error('[Medication] ❌ Failed to log dose');
        alert('Failed to log medication. Please try again.');
      }
    } catch (error) {
      console.error('[Medication] Error logging dose:', error);
      alert('Error logging medication. Please try again.');
    }
  };

  const mockMedications = [
    {
      name: "Adderall XR",
      dose: "20 mg",
      frequency: "Once daily",
      startDate: "Nov 15, 2024",
      active: true,
    },
  ]

  const mockTitrationHistory = [
    {
      dose: "10 mg",
      startDate: "Nov 15, 2024",
      endDate: "Nov 28, 2024",
      duration: "2 weeks",
      focusScore: 60,
      hrvAvg: 36,
      sleepHours: 7.2,
      restingHR: 72,
      sideEffects: ["Mild appetite loss"],
      notes: "Starting dose, some improvement but inconsistent",
    },
    {
      dose: "20 mg",
      startDate: "Nov 29, 2024",
      endDate: null,
      duration: "2 weeks",
      focusScore: 85,
      hrvAvg: 42,
      sleepHours: 6.8,
      restingHR: 76,
      sideEffects: ["Moderate appetite loss", "Slight insomnia"],
      notes: "Significant improvement in focus and task completion",
      current: true,
    },
  ]

  return (
    <View className="pb-24">
      <View className="bg-gradient-to-br from-primary/10 via-primary/5 to-background p-8 mb-6">
        <Text className="text-3xl font-bold text-foreground mb-2">Medications</Text>
        <Text className="text-muted-foreground">Track dosing and titration journey</Text>
      </View>

      <View className="px-4 mb-6">
        <View className="flex gap-2 bg-muted/30 p-1 rounded-xl">
          <TouchableOpacity
            onPress={() => setActiveTab("log")}
            className={`flex-1 py-2.5 px-4 rounded-lg text-sm font-medium transition-all ${
              activeTab === "log" ? "bg-card text-foreground shadow-sm" : "text-muted-foreground hover:text-foreground"
            }`}
          >
            Log
          </TouchableOpacity>
          <TouchableOpacity
            onPress={() => setActiveTab("titration")}
            className={`flex-1 py-2.5 px-4 rounded-lg text-sm font-medium transition-all ${
              activeTab === "titration"
                ? "bg-card text-foreground shadow-sm"
                : "text-muted-foreground hover:text-foreground"
            }`}
          >
            Titration
          </TouchableOpacity>
          <TouchableOpacity
            onPress={() => setActiveTab("history")}
            className={`flex-1 py-2.5 px-4 rounded-lg text-sm font-medium transition-all ${
              activeTab === "history"
                ? "bg-card text-foreground shadow-sm"
                : "text-muted-foreground hover:text-foreground"
            }`}
          >
            History
          </TouchableOpacity>
        </View>
      </View>

      <View className="px-4">
        {activeTab === "log" && (
          <View className="space-y-6">
            {/* Today's medication log */}
            <View>
              <Text className="text-lg font-semibold text-foreground mb-4">Today's Medication</Text>
              <View className="bg-card rounded-xl p-6 border border-border shadow-md">
                <View className="flex items-center justify-between mb-4">
                  <View>
                    <Text className="text-base font-semibold text-foreground">Adderall XR</Text>
                    <Text className="text-sm text-muted-foreground">20 mg • Once daily</Text>
                  </View>
                  {loggedToday ? (
                    <View className="flex items-center gap-2 text-chart-2">
                      <svg className="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <Textath strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M5 13l4 4L19 7" />
                      </svg>
                      <Text className="text-sm font-medium">Logged</Text>
                    </View>
                  ) : (
                    <Badge variant="outline" className="bg-yellow-500/10 text-yellow-600 border-yellow-500/20">
                      Not logged
                    </Badge>
                  )}
                </View>

                {!loggedToday && (
                  <TouchableOpacity onPress={handleLogDose} className="w-full rounded-full mb-4">
                    I Took My Medication
                  </TouchableOpacity>
                )}

                <View className="pt-4 border-t border-border">
                  <Text className="text-sm font-medium text-foreground mb-3">How are you feeling today?</Text>
                  <View className="flex gap-2 mb-4">
                    {["😫", "😕", "😐", "🙂", "😊"].map((emoji, i) => (
                      <TouchableOpacity
                        key={i}
                        className="flex-1 py-3 rounded-lg bg-muted/30 hover:bg-muted/50 transition-colors text-2xl"
                      >
                        {emoji}
                      </TouchableOpacity>
                    ))}
                  </View>

                  <Text className="text-sm font-medium text-foreground mb-3">Any side effects today?</Text>
                  <View className="flex flex-wrap gap-2">
                    {["Appetite loss", "Insomnia", "Anxiety", "Headache", "Dry mouth", "Nausea"].map((effect) => (
                      <TouchableOpacity
                        key={effect}
                        className="px-3 py-1.5 rounded-full text-xs font-medium bg-muted/30 text-muted-foreground hover:bg-primary/10 hover:text-primary transition-colors"
                      >
                        {effect}
                      </TouchableOpacity>
                    ))}
                  </View>
                </View>
              </View>
            </View>

            {/* Quick stats */}
            <View>
              <Text className="text-lg font-semibold text-foreground mb-4">This Week</Text>
              <View className="grid grid-cols-2 gap-3">
                <View className="bg-card rounded-lg p-4 border border-border">
                  <Text className="text-xs text-muted-foreground mb-1">Doses Logged</Text>
                  <Text className="text-2xl font-bold text-foreground">6/7</Text>
                  <Text className="text-xs text-chart-2 mt-1">86% adherence</Text>
                </View>
                <View className="bg-card rounded-lg p-4 border border-border">
                  <Text className="text-xs text-muted-foreground mb-1">Side Effects</Text>
                  <Text className="text-2xl font-bold text-foreground">3</Text>
                  <Text className="text-xs text-muted-foreground mt-1">All mild</Text>
                </View>
              </View>
            </View>
          </View>
        )}

        {activeTab === "titration" && (
          <View className="space-y-6">
            <View className="flex items-center justify-between">
              <View>
                <Text className="text-lg font-semibold text-foreground">Titration Journey</Text>
                <Text className="text-sm text-muted-foreground">Finding your optimal dose</Text>
              </View>
              <TouchableOpacity size="sm" variant="outline" className="rounded-full bg-transparent">
                Change Dose
              </TouchableOpacity>
            </View>

            {/* Timeline visualization */}
            <View className="relative">
              <View className="absolute left-6 top-8 bottom-8 w-0.5 bg-border" />

              {mockTitrationHistory.map((entry, index) => (
                <View key={index} className="relative pl-14 pb-8 last:pb-0">
                  {/* Timeline dot */}
                  <View
                    className={`absolute left-4 top-6 w-5 h-5 rounded-full border-4 ${
                      entry.current ? "bg-primary border-primary/20" : "bg-card border-border"
                    }`}
                  />

                  {/* Dose card */}
                  <View
                    className={`bg-card rounded-xl border ${
                      entry.current ? "border-primary shadow-lg" : "border-border shadow-sm"
                    } overflow-hidden`}
                  >
                    <View
                      className="p-4 cursor-pointer hover:bg-muted/30 transition-colors"
                      onPress={() => setExpandedDose(expandedDose === entry.dose ? null : entry.dose)}
                    >
                      <View className="flex items-center justify-between mb-2">
                        <View className="flex items-center gap-3">
                          <Text className="text-2xl font-bold text-foreground">{entry.dose}</Text>
                          {entry.current && <Badge className="bg-primary/10 text-primary border-0">Current</Badge>}
                        </View>
                        <svg
                          className={`w-5 h-5 text-muted-foreground transition-transform ${
                            expandedDose === entry.dose ? "rotate-180" : ""
                          }`}
                          fill="none"
                          viewBox="0 0 24 24"
                          stroke="currentColor"
                        >
                          <Textath strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M19 9l-7 7-7-7" />
                        </svg>
                      </View>

                      <Text className="text-sm text-muted-foreground mb-3">
                        {entry.startDate} {entry.endDate ? `- ${entry.endDate}` : "- Present"} ({entry.duration})
                      </Text>

                      {/* Quick stats */}
                      <View className="grid grid-cols-4 gap-3">
                        <View className="text-center">
                          <Text className="text-xs text-muted-foreground mb-1">Focus</Text>
                          <Text className="text-lg font-bold text-foreground">{entry.focusScore}</Text>
                        </View>
                        <View className="text-center">
                          <Text className="text-xs text-muted-foreground mb-1">HRV</Text>
                          <Text className="text-lg font-bold text-foreground">{entry.hrvAvg}</Text>
                        </View>
                        <View className="text-center">
                          <Text className="text-xs text-muted-foreground mb-1">Sleep</Text>
                          <Text className="text-lg font-bold text-foreground">{entry.sleepHours}h</Text>
                        </View>
                        <View className="text-center">
                          <Text className="text-xs text-muted-foreground mb-1">HR</Text>
                          <Text className="text-lg font-bold text-foreground">{entry.restingHR}</Text>
                        </View>
                      </View>
                    </View>

                    {/* Expanded details */}
                    {expandedDose === entry.dose && (
                      <View className="border-t border-border bg-muted/30 p-4 space-y-4">
                        {/* Side effects */}
                        <View>
                          <Text className="text-xs font-semibold text-muted-foreground uppercase tracking-wider mb-2">
                            Side Effects
                          </Text>
                          <View className="flex flex-wrap gap-2">
                            {entry.sideEffects.length > 0 ? (
                              entry.sideEffects.map((effect, i) => (
                                <Badge key={i} variant="outline" className="bg-card">
                                  {effect}
                                </Badge>
                              ))
                            ) : (
                              <Text className="text-sm text-muted-foreground">None reported</Text>
                            )}
                          </View>
                        </View>

                        {/* Notes */}
                        <View>
                          <Text className="text-xs font-semibold text-muted-foreground uppercase tracking-wider mb-2">
                            Clinical Notes
                          </Text>
                          <Text className="text-sm text-foreground leading-relaxed">{entry.notes}</Text>
                        </View>

                        {/* Biomarker comparison */}
                        {index > 0 && (
                          <View>
                            <Text className="text-xs font-semibold text-muted-foreground uppercase tracking-wider mb-3">
                              Changes from Previous Dose
                            </Text>
                            <View className="grid grid-cols-2 gap-3">
                              <View className="bg-card rounded-lg p-3">
                                <Text className="text-xs text-muted-foreground mb-1">Focus Score</Text>
                                <View className="flex items-center gap-2">
                                  <Text className="text-lg font-bold text-foreground">
                                    {mockTitrationHistory[index - 1].focusScore} → {entry.focusScore}
                                  </Text>
                                  <Text
                                    className={`text-sm font-semibold ${
                                      entry.focusScore > mockTitrationHistory[index - 1].focusScore
                                        ? "text-chart-2"
                                        : "text-destructive"
                                    }`}
                                  >
                                    {entry.focusScore > mockTitrationHistory[index - 1].focusScore ? "+" : ""}
                                    {Math.round(
                                      ((entry.focusScore - mockTitrationHistory[index - 1].focusScore) /
                                        mockTitrationHistory[index - 1].focusScore) *
                                        100,
                                    )}
                                    %
                                  </Text>
                                </View>
                              </View>
                              <View className="bg-card rounded-lg p-3">
                                <Text className="text-xs text-muted-foreground mb-1">HRV</Text>
                                <View className="flex items-center gap-2">
                                  <Text className="text-lg font-bold text-foreground">
                                    {mockTitrationHistory[index - 1].hrvAvg} → {entry.hrvAvg}
                                  </Text>
                                  <Text
                                    className={`text-sm font-semibold ${
                                      entry.hrvAvg > mockTitrationHistory[index - 1].hrvAvg
                                        ? "text-chart-2"
                                        : "text-destructive"
                                    }`}
                                  >
                                    {entry.hrvAvg > mockTitrationHistory[index - 1].hrvAvg ? "+" : ""}
                                    {Math.round(
                                      ((entry.hrvAvg - mockTitrationHistory[index - 1].hrvAvg) /
                                        mockTitrationHistory[index - 1].hrvAvg) *
                                        100,
                                    )}
                                    %
                                  </Text>
                                </View>
                              </View>
                            </View>
                          </View>
                        )}

                        <TouchableOpacity variant="outline" size="sm" className="w-full rounded-full bg-transparent">
                          Generate Doctor Report
                        </TouchableOpacity>
                      </View>
                    )}
                  </View>
                </View>
              ))}
            </View>

            {/* Titration insights */}
            <View className="bg-gradient-to-br from-chart-2/10 to-chart-2/5 rounded-xl p-5 border border-chart-2/20">
              <View className="flex items-start gap-3">
                <View className="w-8 h-8 rounded-full bg-chart-2/20 flex items-center justify-center flex-shrink-0">
                  <svg className="w-4 h-4 text-chart-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <Textath strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M13 10V3L4 14h7v7l9-11h-7z" />
                  </svg>
                </View>
                <View>
                  <Text className="text-sm font-semibold text-foreground mb-1">Optimal Dose Detected</Text>
                  <Text className="text-xs text-muted-foreground leading-relaxed">
                    Current 20mg dose shows the best balance of efficacy (85 Focus Score) with manageable side effects.
                    Consider maintaining this dose for 4-6 weeks before reassessment.
                  </Text>
                </View>
              </View>
            </View>
          </View>
        )}

        {activeTab === "history" && (
          <View className="space-y-6">
            <View>
              <Text className="text-lg font-semibold text-foreground mb-4">Active Medications</Text>
              {mockMedications.map((med) => (
                <View key={med.name} className="bg-card rounded-xl p-6 border border-border shadow-md mb-4">
                  <View className="flex items-start justify-between mb-4">
                    <View className="flex-1">
                      <View className="flex items-center gap-2 mb-2">
                        <Text className="text-base font-semibold text-foreground">{med.name}</Text>
                        <Badge className="bg-chart-2/10 text-chart-2 border-0">Active</Badge>
                      </View>
                      <Text className="text-sm text-muted-foreground mb-1">
                        {med.dose} • {med.frequency}
                      </Text>
                      <Text className="text-xs text-muted-foreground">Started: {med.startDate}</Text>
                    </View>
                    <TouchableOpacity className="text-primary text-sm font-medium hover:underline">Edit</TouchableOpacity>
                  </View>

                  <View className="bg-gradient-to-r from-chart-2/10 to-chart-2/5 rounded-xl p-4 border border-chart-2/20">
                    <Text className="text-xs font-semibold text-muted-foreground uppercase tracking-wider mb-2">
                      Impact Summary
                    </Text>
                    <View className="grid grid-cols-2 gap-4">
                      <View>
                        <Text className="text-xs text-muted-foreground mb-1">HRV</Text>
                        <Text className="text-xl font-bold text-foreground">
                          36 → 42 <Text className="text-sm text-chart-2">+15%</Text>
                        </Text>
                      </View>
                      <View>
                        <Text className="text-xs text-muted-foreground mb-1">Focus Score</Text>
                        <Text className="text-xl font-bold text-foreground">
                          60 → 85 <Text className="text-sm text-chart-2">+42%</Text>
                        </Text>
                      </View>
                    </View>
                  </View>
                </View>
              ))}

              <TouchableOpacity className="w-full rounded-full">Add Medication</TouchableOpacity>
            </View>

            <View>
              <Text className="text-lg font-semibold text-foreground mb-4">Past Medications</Text>
              <View className="space-y-3">
                <View className="bg-card rounded-lg p-4 border border-border">
                  <View className="flex items-center justify-between">
                    <View>
                      <Text className="text-sm font-medium text-foreground">Strattera 40mg</Text>
                      <Text className="text-xs text-muted-foreground">Aug 2024 - Oct 2024</Text>
                      <Badge variant="outline" className="mt-2 text-xs">
                        Discontinued
                      </Badge>
                    </View>
                    <TouchableOpacity className="text-primary text-sm font-medium hover:underline">View Report</TouchableOpacity>
                  </View>
                </View>

                <View className="bg-card rounded-lg p-4 border border-border">
                  <View className="flex items-center justify-between">
                    <View>
                      <Text className="text-sm font-medium text-foreground">Ritalin 10mg</Text>
                      <Text className="text-xs text-muted-foreground">Jan 2024 - Jul 2024</Text>
                      <Badge variant="outline" className="mt-2 text-xs">
                        Switched
                      </Badge>
                    </View>
                    <TouchableOpacity className="text-primary text-sm font-medium hover:underline">View Report</TouchableOpacity>
                  </View>
                </View>
              </View>
            </View>
          </View>
        )}
      </View>
    </View>
  )
}
