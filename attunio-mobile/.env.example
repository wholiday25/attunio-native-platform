# AWS Configuration
EXPO_PUBLIC_AWS_REGION=us-east-1
EXPO_PUBLIC_AWS_ACCOUNT_ID=your_aws_account_id
EXPO_PUBLIC_COGNITO_USER_POOL_ID=your_user_pool_id_here
EXPO_PUBLIC_COGNITO_CLIENT_ID=your_client_id_here
EXPO_PUBLIC_COGNITO_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/your_user_pool_id

# API Endpoints
EXPO_PUBLIC_API_URL=https://your-api-gateway-url.amazonaws.com/stage
EXPO_PUBLIC_GENAI_API_URL=https://your-genai-api-url.amazonaws.com/prod
EXPO_PUBLIC_GENAI_API_KEY=your_api_key_here
EXPO_PUBLIC_GENAI_ENABLED=true

# Terra API (for wearable integration)
EXPO_PUBLIC_TERRA_DEV_ID=your_terra_dev_id_here
EXPO_PUBLIC_TERRA_API_KEY=your_terra_api_key_here
EXPO_PUBLIC_TERRA_WEBHOOK_URL=https://your-domain.com/api/terra/webhook

# Sentry Error Tracking (optional)
EXPO_PUBLIC_SENTRY_DSN=your_sentry_dsn_here

# Environment
EXPO_PUBLIC_NODE_ENV=development
EXPO_PUBLIC_APP_URL=http://localhost:8081
