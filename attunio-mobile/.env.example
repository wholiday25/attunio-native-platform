# AWS Configuration
EXPO_PUBLIC_AWS_REGION=us-east-1
EXPO_PUBLIC_COGNITO_USER_POOL_ID=your_user_pool_id_here
EXPO_PUBLIC_COGNITO_CLIENT_ID=your_client_id_here

# API Endpoints
EXPO_PUBLIC_API_URL=https://your-api-gateway-url.amazonaws.com/stage
EXPO_PUBLIC_GENAI_API_URL=https://your-genai-api-url.amazonaws.com/prod
EXPO_PUBLIC_GENAI_API_KEY=your_api_key_here

# Terra API (for wearable integration)
EXPO_PUBLIC_TERRA_DEV_ID=your_terra_dev_id_here
