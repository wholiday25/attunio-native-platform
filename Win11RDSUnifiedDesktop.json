{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "imageTemplateName": {
            "type": "string"
        },
        "InstalledApplicationsURI": {
            "type": "string"
        },
        "api-version": {
            "type": "string"
        },
        "svclocation": {
            "type": "string"
        },
        "ManagedIdentityID": {
            "type": "string"
        },
        "SharedImageGalleryID": {
            "type": "string"
        },
        "SubnetID": {
            "type": "string"
        },
        "imageVersionID": {
            "type": "string",
            "metadata": {
                "description": "URL for Shared Image Gallery for Enterprise Desktop"
            }
        },
        "MetasolvInstallerURI": {
            "type": "string"
        },
        "MetasolvDEVInstallerURI": {
            "type": "string"
        },
        "SupportNowLogmeInURI": {
            "type": "string"
        },
        "SecureCRTInstallerURI": {
            "type": "string"
        },
        "RSASecurIDTokenInstallerURI": {
            "type": "string"
        },
        "AccessDatabaseEngineURI": {
            "type": "string"
        },"SAPGUIInstallerURI": {
            "type": "string"
        },
        "SAPHanaAdobeLifecycleURI": {
            "type": "string"
        }
    },

    "variables": {
        "MetaSolvDownloadCMD": "[concat('(New-Object System.Net.WebClient).DownloadFile(\"',parameters('MetaSolvInstallerURI'),'\", \"C:\\Comcast\\Install-Metasolvb367Prod0317.zip\")')]",
        "MetaSolvDEVDownloadCMD": "[concat('(New-Object System.Net.WebClient).DownloadFile(\"',parameters('MetasolvDEVInstallerURI'),'\", \"C:\\Comcast\\Install-MetasolvDev631b367.zip\")')]",
        "RSASecurIDTokenDownloadCMD": "[concat('(New-Object System.Net.WebClient).DownloadFile(\"',parameters('RSASecurIDTokenInstallerURI'),'\", \"C:\\Comcast\\Install-RSASecurIDToken.zip\")')]",
        "AccessDatabaseEngineCMD": "[concat('(New-Object System.Net.WebClient).DownloadFile(\"',parameters('AccessDatabaseEngineURI'),'\", \"C:\\Comcast\\AccessDatabaseEngine.exe\")')]",
        "SAPGUIDownloadCMD": "[concat('(New-Object System.Net.WebClient).DownloadFile(\"',parameters('SAPGUIInstallerURI'),'\", \"C:\\Comcast\\Install-SAPGUI.zip\")')]",
        "SupportNowLogmeInCMD": "[concat('(New-Object System.Net.WebClient).DownloadFile(\"',parameters('SupportNowLogmeInURI'),'\", \"C:\\Comcast\\Install-SupportNowLogmeIn.zip\")')]",
        "SecureCRTDownloadCMD": "[concat('(New-Object System.Net.WebClient).DownloadFile(\"',parameters('SecureCRTInstallerURI'),'\", \"C:\\Comcast\\Install-SecureCRT.zip\")')]",
        "SAPHanaAdobeLifecycleDownloadCMD": "[concat('(New-Object System.Net.WebClient).DownloadFile(\"',parameters('SAPHanaAdobeLifecycleURI'),'\", \"C:\\Comcast\\Install-SAPHanaAdobeLifecycle.zip\")')]",
        "InstalledApplicationsAzcopy": "[concat('azcopy copy \"C:\\Comcast\\Win11RDSUnifiedDesktop.csv\" \"',parameters('InstalledApplicationsURI'),'\"')]"
    },


    "resources": [
        {
            "name": "[parameters('imageTemplateName')]",
            "type": "Microsoft.VirtualMachineImages/imageTemplates",
            "apiVersion": "[parameters('api-version')]",
            "location": "[parameters('svclocation')]",
            "dependsOn": [],
            "tags": {
                "userIdentity": "enabled"
            },
            "identity": {
                "type": "UserAssigned",
                "userAssignedIdentities": {
                    "[parameters('ManagedIdentityID')]": {}
                }
            },

            "properties": {
                "buildTimeoutInMinutes": 600,

                "vmProfile": {
                    "vmSize": "Standard_D4s_v5",
                    "osDiskSizeGB": 256,
                    "vnetConfig": {
                        "subnetId": "[parameters('SubnetID')]"
                    }
                },
                "source": {
                    "type": "SharedImageVersion",
                    "imageVersionId": "[parameters('imageVersionID')]"
                },

                "customize": [
                    {
                        "type": "PowerShell",
                        "name": "Install NotepadPP",
                        "runElevated": true,
                        "runAsSystem": true,
                        "scriptUri": "https://aibdev.blob.core.windows.net/scripts/Install-NotepadPP.ps1",
                        "validExitCodes": [0,3010]
                    },
                   {
                        "type": "PowerShell",
                        "name": "Install FireFox",
                        "runElevated": true,
                        "runAsSystem": true,
                        "scriptUri": "https://aibdev.blob.core.windows.net/scripts/Install-FireFox.ps1",
                        "validExitCodes": [0,3010]
                    },
                    {
                        "type": "PowerShell",
                        "name": "Install Putty",
                        "runElevated": true,
                        "runAsSystem": true,
                        "scriptUri": "https://aibdev.blob.core.windows.net/scripts/Install-Putty.ps1",
                        "validExitCodes": [0,3010]
                    }, 
                    {
                        "type": "PowerShell",
                        "name": "Download SecureCRT",
                        "inline": ["[variables('SecureCRTDownloadCMD')]"]                    
                    },
                    {
                        "type": "PowerShell",
                        "name": "Install SecureCRT",
                        "runElevated": true,
                        "runAsSystem": true,
                        "scriptUri": "https://aibdev.blob.core.windows.net/scripts/Install-SecureCRT.ps1",
                        "validExitCodes": [0,3010]
                    },
                    {
                        "type": "PowerShell",
                        "name": "Install SOAP UI",
                        "runElevated": true,
                        "runAsSystem": true,
                        "scriptUri": "https://aibdev.blob.core.windows.net/scripts/Install-SOAPUI.ps1",
                        "validExitCodes": [0,3010]
                    },
                     {
                        "type": "PowerShell",
                        "name": "Install SQL Management Studio",
                        "runElevated": true,
                        "runAsSystem": true,
                        "scriptUri": "https://aibdev.blob.core.windows.net/scripts/Install-SQLManagementStudio.ps1",
                        "validExitCodes": [0,3010]
                    },
                    {
                        "type": "PowerShell",
                        "name": "Download SupportNowLogmeInCMD",
                        "inline": ["[variables('SupportNowLogmeInCMD')]"]                    
                    },
                    {
                        "type": "PowerShell",
                        "name": "Install SupportNowLogMeIn",
                        "runElevated": true,
                        "runAsSystem": true,
                        "scriptUri": "https://aibdev.blob.core.windows.net/scripts/Install-SupportNowLogmeIn.ps1",
                        "validExitCodes": [0,3010]
                    },
                    {
                        "type": "PowerShell",
                        "name": "Install UltraVNC",
                        "runElevated": true,
                        "runAsSystem": true,
                        "scriptUri": "https://aibdev.blob.core.windows.net/scripts/Install-UltraVNC.ps1",
                        "validExitCodes": [0,3010]
                    },
                    {
                        "type": "PowerShell",
                        "name": "Install WinSCP",
                        "runElevated": true,
                        "runAsSystem": true,
                        "scriptUri": "https://aibdev.blob.core.windows.net/scripts/Install-WinSCP.ps1",
                        "validExitCodes": [0,3010]
                    },
                    {
                        "type": "PowerShell",
                        "name": "Download MetaSolvDownloadCMD",
                        "inline": ["[variables('MetaSolvDownloadCMD')]"]               
                    },
                    {
                        "type": "PowerShell",
                        "name": "Download MetaSolvDEVDownloadCMD",
                        "inline": ["[variables('MetaSolvDEVDownloadCMD')]"]               
                    }
                    ,{
                        "type": "PowerShell",
                        "name": "Install MetasolvDev631b367",
                        "runElevated": true,
                        "runAsSystem": true,
                        "scriptUri": "https://aibdev.blob.core.windows.net/scripts/Install-MetasolvDev631b367.ps1",
                        "validExitCodes": [0,3010]
                    },
                    {
                        "type": "PowerShell",
                        "name": "Download AccessDatabaseEngineCMD",
                        "inline": ["[variables('AccessDatabaseEngineCMD')]"]               
                    },
                    {
                        "type": "PowerShell",
                        "name": "Install AccessDatabaseEngineCMD",
                        "runElevated": true,
                        "runAsSystem": true,
                        "scriptUri": "https://aibdev.blob.core.windows.net/scripts/Install-AccessDatabaseEngine.ps1",
                        "validExitCodes": [0,3010]
                    },{
                        "type": "PowerShell",
                        "name": "Install Java x86 V 1.8.341",
                        "runElevated": true,
                        "runAsSystem": true,
                        "scriptUri": "https://aibdev.blob.core.windows.net/scripts/Install-JREx86-RDS-341.ps1",
                        "validExitCodes": [0,3010]
                    },{
                        "type": "PowerShell",
                        "name": "Install Java x64 V 1.8.341",
                        "runElevated": true,
                        "runAsSystem": true,
                        "scriptUri": "https://aibdev.blob.core.windows.net/scripts/Install-JREx64-RDS-341.ps1",
                        "validExitCodes": [0,3010]
                    },
                              {
                        "type": "PowerShell",
                        "name": "Install Metasolv",
                        "runElevated": true,
                        "runAsSystem": true,
                        "scriptUri": "https://aibdev.blob.core.windows.net/scripts/Install-Metasolvb367Prod0317.ps1",
                        "validExitCodes": [0,3010]
                    },
                    {
                        "type": "PowerShell",
                        "name": "Download RSASecurIDTokenCMD",
                        "inline": ["[variables('RSASecurIDTokenDownloadCMD')]"]               
                    },
                              {
                        "type": "PowerShell",
                        "name": "Install RSASecurIDToken",
                        "runElevated": true,
                        "runAsSystem": true,
                        "scriptUri": "https://aibdev.blob.core.windows.net/scripts/Install-RSASecurIDToken.ps1",
                        "validExitCodes": [0,3010]
                    },
                    {
                        "type": "PowerShell",
                        "name": "Download SAPGUIDownloadCMD",
                        "inline": ["[variables('SAPGUIDownloadCMD')]"]               
                    },
                              {
                        "type": "PowerShell",
                        "name": "Install SAPGUI",
                        "runElevated": true,
                        "runAsSystem": true,
                        "scriptUri": "https://aibdev.blob.core.windows.net/scripts/Install-SAPGUI.ps1",
                        "validExitCodes": [0,3010]
                    },
                    {
                        "type": "PowerShell",
                        "name": "Download SAPHanaAdobeLifecycleDownloadCMD",
                        "inline": ["[variables('SAPHanaAdobeLifecycleDownloadCMD')]"]               
                    },
                              {
                        "type": "PowerShell",
                        "name": "Install SAPHanaAdobeLifecycle",
                        "runElevated": true,
                        "runAsSystem": true,
                        "scriptUri": "https://aibdev.blob.core.windows.net/scripts/Install-SAPHanaAdobeLifecycle.ps1",
                        "validExitCodes": [0,3010]
                    },
                    {
                        "type": "PowerShell",
                        "name": "CollectInstalledApps",
                        "runElevated": true,
                        "runAsSystem": true,
                        "inline": ["Get-ItemProperty HKLM:\\Software\\Wow6432Node\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\*,HKLM:\\Software\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\* | Select-Object DisplayName, DisplayVersion, Publisher, InstallDate -Unique | Where-Object {$_.DisplayName -ne \"\"} | Sort-Object -Property DisplayName | Export-CSV C:\\Comcast\\Win11RDSUnifiedDesktop.csv -NoTypeInformation","choco install azcopy10 -y --no-progress" ,"[variables('InstalledApplicationsAzcopy')]"]           
                    },
                    {
                        "type": "WindowsRestart",
                        "restartCheckCommand": "Write-Output 'restarting post Developer apps installation'",
                        "restartTimeout": "10m"
                    },
                    {
                        "type": "PowerShell",
                        "name": "Pause to fix SysPrep",
                        "runElevated": true,
                        "runAsSystem": true,
                        "inline": ["Start-Sleep -Seconds 300"]
                    }                 
                ],
                "distribute": [
                    {
                        "type": "SharedImage",
                        "galleryImageId": "[concat(parameters('SharedImageGalleryID'),'/images/',parameters('ImageTemplateName'))]",
                        "runOutputName": "sigOutput",
                        "artifactTags": {
                            "source": "win11-22h2-avd-m365",
                            "baseosimg": "win11-22h2-avd"
                        },
                        "replicationRegions": [
                            "eastus"
                        ]
                    }
                ]
            }
        }
    ]
}