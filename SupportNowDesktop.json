{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "imageTemplateName": {
            "type": "string"
        },
        "InstalledApplicationsURI": {
            "type": "string"
        },
        "api-version": {
            "type": "string"
        },
        "svclocation": {
            "type": "string"
        },
        "ManagedIdentityID": {
            "type": "string"
        },
        "SharedImageGalleryID": {
            "type": "string"
        },
        "SubnetID": {
            "type": "string"
        },
        "imageVersionID": {
            "type": "string",
            "metadata": {
                "description": "URL for Shared Image Gallery for Enterprise Desktop"
            }
        },
        "SupportNowLogmeInURI": {
            "type": "string"
        },
        "SupportNowRumbaURI": {
            "type": "string"
        }
    },

    "variables": {
        "SupportNowLogmeInCMD": "[concat('(New-Object System.Net.WebClient).DownloadFile(\"',parameters('SupportNowLogmeInURI'),'\", \"C:\\Comcast\\Install-SupportNowLogmeIn.zip\")')]",
        "SupportNowRumbaCMD": "[concat('(New-Object System.Net.WebClient).DownloadFile(\"',parameters('SupportNowRumbaURI'),'\", \"C:\\Comcast\\Install-SupportNowRumba.zip\")')]",
        "InstalledApplicationsAzcopy": "[concat('azcopy copy \"C:\\Comcast\\SupportNowDesktop.csv\" \"',parameters('InstalledApplicationsURI'),'\"')]"
    },


    "resources": [
        {
            "name": "[parameters('imageTemplateName')]",
            "type": "Microsoft.VirtualMachineImages/imageTemplates",
            "apiVersion": "[parameters('api-version')]",
            "location": "[parameters('svclocation')]",
            "dependsOn": [],
            "tags": {
                "userIdentity": "enabled"
            },
            "identity": {
                "type": "UserAssigned",
                "userAssignedIdentities": {
                    "[parameters('ManagedIdentityID')]": {}
                }
            },

            "properties": {
                "buildTimeoutInMinutes": 120,

                "vmProfile": {
                    "vmSize": "Standard_D4s_v5",
                    "osDiskSizeGB": 128,
                    "vnetConfig": {
                        "subnetId": "[parameters('SubnetID')]"
                    }
                },
                "source": {
                    "type": "SharedImageVersion",
                    "imageVersionID": "[parameters('imageVersionID')]"
                },

                "customize": [
                    {
                        "type": "PowerShell",
                        "name": "Download SupportNowLogmeInCMD",
                        "inline": ["[variables('SupportNowLogmeInCMD')]"]                    
                    },
                    {
                        "type": "PowerShell",
                        "name": "Download SupportNowRumbaCMD",
                        "inline": ["[variables('SupportNowRumbaCMD')]"]           
                    },
                    {
                        "type": "PowerShell",
                        "name": "Install LogMeIn",
                        "runElevated": true,
                        "runAsSystem": true,
                        "scriptUri": "https://aibdev.blob.core.windows.net/scripts/Install-SupportNowLogmeIn.ps1"
                    },                    {
                        "type": "PowerShell",
                        "name": "Install Rumba",
                        "runElevated": true,
                        "runAsSystem": true,
                        "scriptUri": "https://aibdev.blob.core.windows.net/scripts/Install-SupportNowRumba.ps1"
                    },
                                         {
                        "type": "PowerShell",
                        "name": "Install RSAT Tools ",
                        "runElevated": true,
                        "runAsSystem": true,
                        "scriptUri": "https://aibdev.blob.core.windows.net/scripts/Install-SupportNowRSAT.ps1"
                    },
                    {
                        "type": "PowerShell",
                        "name": "CollectInstalledApps",
                        "runElevated": true,
                        "runAsSystem": true,
                        "inline": ["Get-ItemProperty HKLM:\\Software\\Wow6432Node\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\*,HKLM:\\Software\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\* | Select-Object DisplayName, DisplayVersion, Publisher, InstallDate -Unique | Where-Object {$_.DisplayName -ne \"\"} | Sort-Object -Property DisplayName | Export-CSV C:\\Comcast\\SupportNowDesktop.csv -NoTypeInformation","choco install azcopy10  --version=10.13.0 -y --no-progress","[variables('InstalledApplicationsAzcopy')]"]           
                    },
                    {
                        "type": "WindowsRestart",
                        "restartCheckCommand": "Write-Output 'restarting post SupportNow Installation'",
                        "restartTimeout": "10m"
                    },
                    {
                        "type": "PowerShell",
                        "name": "Pause to fix SysPrep",
                        "runElevated": true,
                        "runAsSystem": true,
                        "inline": ["Start-Sleep -Seconds 300"]
                    }
                ],
                "distribute": [
                    {
                        "type": "SharedImage",
                        "galleryImageId": "[concat(parameters('SharedImageGalleryID'),'/images/',parameters('ImageTemplateName'))]",
                        "runOutputName": "sigOutput",
                        "artifactTags": {
                            "source": "21h1-evd-o365pp-g2",
                            "baseosimg": "21h1-evd-o365pp-g2"
                        },
                        "replicationRegions": [
                            "eastus"
                        ]
                    }
                ]
            }
        }
    ]
}