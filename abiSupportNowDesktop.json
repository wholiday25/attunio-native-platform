{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "imageTemplateName": {
            "type": "string"
        },
        "api-version": {
            "type": "string"
        },
        "svclocation": {
            "type": "string"
        },
        "ManagedIdentityID": {
            "type": "string"
        },
        "SharedImageGalleryID": {
            "type": "string"
        },
        "SubnetID": {
            "type": "string"
        },
        "SupportNowLogmeInURI": {
            "type": "string"
        },
        "SupportNowRumbaURI": {
            "type": "string"
        }
    },

    "variables": {
        "SupportNowLogmeInCMD": "[concat('(New-Object System.Net.WebClient).DownloadFile(\"',parameters('SupportNowLogmeInURI'),'\", \"C:\\Comcast\\Install-SupportNowLogmeIn.zip\")')]",
        "SupportNowRumbaCMD": "[concat('(New-Object System.Net.WebClient).DownloadFile(\"',parameters('SupportNowRumbaURI'),'\", \"C:\\Comcast\\Install-SupportNowRumba.zip\")')]"

    },


    "resources": [
        {
            "name": "[parameters('imageTemplateName')]",
            "type": "Microsoft.VirtualMachineImages/imageTemplates",
            "apiVersion": "[parameters('api-version')]",
            "location": "[parameters('svclocation')]",
            "dependsOn": [],
            "tags": {
                "userIdentity": "enabled"
            },
            "identity": {
                "type": "UserAssigned",
                "userAssignedIdentities": {
                    "[parameters('ManagedIdentityID')]": {}
                }
            },

            "properties": {
                "buildTimeoutInMinutes": 120,

                "vmProfile": {
                    "vmSize": "Standard_D2_v2",
                    "osDiskSizeGB": 127,
                    "vnetConfig": {
                        "subnetId": "[parameters('SubnetID')]"
                    }
                },
                "source": {
                    "type": "PlatformImage",
                    "publisher": "MicrosoftWindowsDesktop",
                    "offer": "office-365",
                    "sku": "21h1-evd-o365pp",
                    "version": "latest"
                },

                "customize": [
                    {
                        "type": "PowerShell",
                        "name": "Create workd",
                        "runElevated": true,
                        "runAsSystem": true,
                        "inline": ["New-Item -ItemType Directory -Force -Path C:\\Comcast\\"]
                    },
                    {
                        "type": "File",
                        "name": "Download SupportNowLogmeIn",
                        "sourceUri": "https://aibdev.blob.core.windows.net/installers/Install-SupportNowLogmeIn.zip",
                        "destination": "C:\\Comcast\\Install-SupportNowLogmeIn.zip"                    
                    },
                    {
                        "type": "File",
                        "name": "Download Install-SupportNowRumba.zip",
                        "sourceUri": "https://aibdev.blob.core.windows.net/installers/Install-SupportNowRumba.zip",
                        "destination": "C:\\Comcast\\Install-SupportNowRumba.zip"                    
                    },
                    {
                        "type": "PowerShell",
                        "name": "Install Java x64",
                        "runElevated": true,
                        "runAsSystem": true,
                        "scriptUri": "https://aibdev.blob.core.windows.net/scripts/Install-JREx64.ps1"
                    },
                    {
                        "type": "WindowsRestart",
                        "restartCheckCommand": "write-output 'restarting post JREx64 Install'",
                        "restartTimeout": "10m"
                    }

                ],
                "distribute": [
                    {
                        "type": "SharedImage",
                        "galleryImageId": "[concat(parameters('SharedImageGalleryID'),'/images/',parameters('ImageTemplateName'))]",
                        "runOutputName": "sigOutput",
                        "artifactTags": {
                            "source": "wvd10-o365pp",
                            "baseosimg": "windows10-office365pp"
                        },
                        "replicationRegions": [
                            "eastus"
                        ]
                    }
                ]
            }
        }
    ]
}