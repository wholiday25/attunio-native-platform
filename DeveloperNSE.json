{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "imageTemplateName": {
            "type": "string"
        },
        "InstalledApplicationsURI": {
            "type": "string"
        },
        "api-version": {
            "type": "string"
        },
        "svclocation": {
            "type": "string"
        },
        "ManagedIdentityID": {
            "type": "string"
        },
        "SharedImageGalleryID": {
            "type": "string"
        },
        "SubnetID": {
            "type": "string"
        },
        "imageVersionID": {
            "type": "string",
            "metadata": {
                "description": "URL for Shared Image Gallery for Enterprise Desktop"
            }
        },
        "AccessDatabaseEngineURI": {
            "type": "string"
        },
        "Ginger.4.2.0.0_URI": {
            "type": "string"
        },
        "Odbcjava_URI": {
            "type": "string"
        },
        "WinGPG_URI": {
            "type": "string"
        },
        "AdobeCampaignClassic7_URI": {
            "type": "string"
        }
    },

    "variables": {

        "AccessDatabaseEngineCMD": "[concat('(New-Object System.Net.WebClient).DownloadFile(\"',parameters('AccessDatabaseEngineURI'),'\", \"C:\\Comcast\\AccessDatabaseEngine.exe\")')]",
        "Ginger.4.2.0.0_CMD": "[concat('(New-Object System.Net.WebClient).DownloadFile(\"',parameters('Ginger.4.2.0.0_URI'),'\", \"C:\\Comcast\\Install-Ginger.4.2.0.0.exe\")')]",
        "Odbcjava_CMD": "[concat('(New-Object System.Net.WebClient).DownloadFile(\"',parameters('Odbcjava_URI'),'\", \"C:\\Comcast\\Install-Odbcjava.zip\")')]",
        "AdobeCampaignClassic7_CMD": "[concat('(New-Object System.Net.WebClient).DownloadFile(\"',parameters('AdobeCampaignClassic7_URI'),'\", \"C:\\Comcast\\Install-AdobeCampaignClassic7.zip\")')]",
        "WinGPG_CMD": "[concat('(New-Object System.Net.WebClient).DownloadFile(\"',parameters('WinGPG_URI'),'\", \"C:\\Comcast\\Install-WinGPG.zip\")')]",
        "InstalledApplicationsAzcopy": "[concat('azcopy copy \"C:\\Comcast\\DeveloperNSE.csv\" \"',parameters('InstalledApplicationsURI'),'\"')]"
    },


    "resources": [
        {
            "name": "[parameters('imageTemplateName')]",
            "type": "Microsoft.VirtualMachineImages/imageTemplates",
            "apiVersion": "[parameters('api-version')]",
            "location": "[parameters('svclocation')]",
            "dependsOn": [],
            "tags": {
                "userIdentity": "enabled"
            },
            "identity": {
                "type": "UserAssigned",
                "userAssignedIdentities": {
                    "[parameters('ManagedIdentityID')]": {}
                }
            },

            "properties": {
                "buildTimeoutInMinutes": 300,

                "vmProfile": {
                    "vmSize": "Standard_D4s_v5",
                    "osDiskSizeGB": 256,
                    "vnetConfig": {
                        "subnetId": "[parameters('SubnetID')]"
                    }
                },
                "source": {
                    "type": "SharedImageVersion",
                    "imageVersionId": "[parameters('imageVersionID')]"
                },
                "customize": [
                                        {
                        "type": "PowerShell",
                        "name": "Download AccessDatabaseEngineCMD",
                        "inline": ["[variables('AccessDatabaseEngineCMD')]"]                    
                    },
                    {
                        "type": "PowerShell",
                        "name": "Download Ginger.4.2.0.0_CMD",
                        "inline": ["[variables('Ginger.4.2.0.0_CMD')]"]           
                    },  
                    {
                        "type": "PowerShell",
                        "name": "Download AdobeCampaignClassic7 ",
                        "inline": ["[variables('AdobeCampaignClassic7_CMD')]"]           
                    },
                    {
                        "type": "PowerShell",
                        "name": "Download WinGPG ",
                        "inline": ["[variables('WinGPG_CMD')]"]           
                    },
                    {
                        "type": "PowerShell",
                        "name": "Download Odbcjava_CMD",
                        "inline": ["[variables('Odbcjava_CMD')]"]           
                    },
                    {
                        "type": "PowerShell",
                        "name": "Install AccessDatabaseEngineCMD",
                        "runElevated": true,
                        "runAsSystem": true,
                        "scriptUri": "https://aibdev.blob.core.windows.net/scripts/Install-AccessDatabaseEngine.ps1"
                    },                    
                    {
                        "type": "PowerShell",
                        "name": "Install Ginger.4.2.0.0_CMD",
                        "runElevated": true,
                        "runAsSystem": true,
                        "scriptUri": "https://aibdev.blob.core.windows.net/scripts/Install-Ginger.4.2.0.0.ps1"
                    },                    
                    {
                        "type": "PowerShell",
                        "name": "Install Odbcjava_CMD",
                        "runElevated": true,
                        "runAsSystem": true,
                        "scriptUri": "https://aibdev.blob.core.windows.net/scripts/Install-Odbcjava.ps1"
                    },
                    {
                        "type": "PowerShell",
                        "name": "Install NotepadPP",
                        "runElevated": true,
                        "runAsSystem": true,
                        "scriptUri": "https://aibdev.blob.core.windows.net/scripts/Install-NotepadPP.ps1",
                        "validExitCodes": [0,3010]
                    },
                    {
                        "type": "PowerShell",
                        "name": "AWS CLI 2.0",
                        "runElevated": true,
                        "runAsSystem": true,
                        "scriptUri": "https://aibdev.blob.core.windows.net/scripts/Install-AWSCLI.ps1",
                        "validExitCodes": [0,3010]
                    },
                    {
                        "type": "PowerShell",
                        "name": "Azure PowerShell Module",
                        "runElevated": true,
                        "runAsSystem": true,
                        "scriptUri": "https://aibdev.blob.core.windows.net/scripts/Install-AzurePS.ps1",
                        "validExitCodes": [0,3010]
                    },
                    {
                        "type": "PowerShell",
                        "name": "Install ActiveDirectory RSAT",
                        "runElevated": true,
                        "runAsSystem": true,
                        "scriptUri": "https://aibdev.blob.core.windows.net/scripts/Install-SupportNowRSAT.ps1",
                        "validExitCodes": [0,3010]
                    },
                    {

                        "type": "File",
                        "name": "Download VSBuildTools",
                        "sourceUri": "https://aibdev.blob.core.windows.net/installers/vs_buildtools.exe",
                        "destination": "C:\\Comcast\\vs_buildtools.exe"                    
                    },
                    {
                        "type": "PowerShell",
                        "name": "Configure VSBuildTools",
                        "runElevated": true,
                        "runAsSystem": true,
                        "scriptUri": "https://aibdev.blob.core.windows.net/scripts/Install-VSBuildTools.ps1",
                        "validExitCodes": [0,3010]
                    },
                    {
                        "type": "PowerShell",
                        "name": "Install OpenSSL",
                        "runElevated": true,
                        "runAsSystem": true,
                        "scriptUri": "https://aibdev.blob.core.windows.net/scripts/Install-OpenSSL.ps1",
                        "validExitCodes": [0,3010]
                    },
                    {
                        "type": "PowerShell",
                        "name": "Install Python",
                        "runElevated": true,
                        "runAsSystem": true,
                        "scriptUri": "https://aibdev.blob.core.windows.net/scripts/Install-Python.ps1",
                        "validExitCodes": [0,3010]
                    },
                    {
                        "type": "PowerShell",
                        "name": "Install PyCharm",
                        "runElevated": true,
                        "runAsSystem": true,
                        "scriptUri": "https://aibdev.blob.core.windows.net/scripts/Install-PyCharm.ps1",
                        "validExitCodes": [0,3010]
                    },
                    {
                        "type": "PowerShell",
                        "name": "Install PyCharm Pro",
                        "runElevated": true,
                        "runAsSystem": true,
                        "scriptUri": "https://aibdev.blob.core.windows.net/scripts/Install-PyCharmPro.ps1",
                        "validExitCodes": [0,3010]
                    },
                    {
                        "type": "PowerShell",
                        "name": "Install Microsoft Build- openjdk11microsoft",
                        "runElevated": true,
                        "runAsSystem": true,
                        "scriptUri": "https://aibdev.blob.core.windows.net/scripts/Install-openjdk11.ps1",
                        "validExitCodes": [
                            0,
                            3010
                        ]
                    },
                    {
                        "type": "PowerShell",
                        "name": "Install oracle17jdk",
                        "runElevated": true,
                        "runAsSystem": true,
                        "scriptUri": "https://aibdev.blob.core.windows.net/scripts/Install-oracle17jdk.ps1",
                        "validExitCodes": [0,3010]
                    },
                    {
                        "type": "PowerShell",
                        "name": "Install JDK8_211",
                        "runElevated": true,
                        "runAsSystem": true,
                        "scriptUri": "https://aibdev.blob.core.windows.net/scripts/Install-JDK8_211.ps1",
                        "validExitCodes": [0,3010]
                    },
                    {
                        "type": "PowerShell",
                        "name": "Install Maven",
                        "runElevated": true,
                        "runAsSystem": true,
                        "scriptUri": "https://aibdev.blob.core.windows.net/scripts/Install-Maven.ps1",
                        "validExitCodes": [0,3010]
                    },
                    {
                        "type": "PowerShell",
                        "name": "Install Nuget",
                        "runElevated": true,
                        "runAsSystem": true,
                        "scriptUri": "https://aibdev.blob.core.windows.net/scripts/Install-Nuget.ps1",
                        "validExitCodes": [0,3010]
                    },
                    {
                        "type": "PowerShell",
                        "name": "Install Gulp",
                        "runElevated": true,
                        "runAsSystem": true,
                        "scriptUri": "https://aibdev.blob.core.windows.net/scripts/Install-Gulp.ps1",
                        "validExitCodes": [0,3010]
                    },
                    {
                        "type": "PowerShell",
                        "name": "Install Putty",
                        "runElevated": true,
                        "runAsSystem": true,
                        "scriptUri": "https://aibdev.blob.core.windows.net/scripts/Install-Putty.ps1",
                        "validExitCodes": [0,3010]
                    },
                    {
                        "type": "PowerShell",
                        "name": "Install SOAP UI",
                        "runElevated": true,
                        "runAsSystem": true,
                        "scriptUri": "https://aibdev.blob.core.windows.net/scripts/Install-SOAPUI.ps1",
                        "validExitCodes": [0,3010]
                    },
                     {
                        "type": "PowerShell",
                        "name": "Install SQL Management Studio",
                        "runElevated": true,
                        "runAsSystem": true,
                        "scriptUri": "https://aibdev.blob.core.windows.net/scripts/Install-SQLManagementStudio.ps1",
                        "validExitCodes": [0,3010]
                    },
                     {
                        "type": "PowerShell",
                        "name": "Install MySQL Workbench",
                        "runElevated": true,
                        "runAsSystem": true,
                        "scriptUri": "https://aibdev.blob.core.windows.net/scripts/Install-MySQLWorkBench.ps1",
                        "validExitCodes": [0,3010]
                    },
                    {
                        "type": "PowerShell",
                        "name": "Install  MySQLODBC drivers",
                        "runElevated": true,
                        "runAsSystem": true,
                        "scriptUri": "https://aibdev.blob.core.windows.net/scripts/Install-MySQLODBC.ps1",
                        "validExitCodes": [
                            0,
                            3010
                        ]
                    },
                    {
                        "type": "PowerShell",
                        "name": "Install WinSCP",
                        "runElevated": true,
                        "runAsSystem": true,
                        "scriptUri": "https://aibdev.blob.core.windows.net/scripts/Install-WinSCP.ps1",
                        "validExitCodes": [0,3010]
                    },
                    {
                        "type": "PowerShell",
                        "name": "Install Azure Data Studio",
                        "runElevated": true,
                        "runAsSystem": true,
                        "scriptUri": "https://aibdev.blob.core.windows.net/scripts/Install-AzureDataStudio.ps1",
                        "validExitCodes": [0,3010]
                    },
                    {
                        "type": "PowerShell",
                        "name": "Install DBeaver",
                        "runElevated": true,
                        "runAsSystem": true,
                        "scriptUri": "https://aibdev.blob.core.windows.net/scripts/Install-DBeaver.ps1",
                        "validExitCodes": [0,3010]
                    },
                    {
                        "type": "PowerShell",
                        "name": "Install MongoDB Compass",
                        "runElevated": true,
                        "runAsSystem": true,
                        "scriptUri": "https://aibdev.blob.core.windows.net/scripts/Install-MongoDBCompass.ps1",
                        "validExitCodes": [0,3010]
                    },
                    {
                        "type": "PowerShell",
                        "name": "Install InelliJ IDEA",
                        "runElevated": true,
                        "runAsSystem": true,
                        "scriptUri": "https://aibdev.blob.core.windows.net/scripts/Install-IntelliJIDEA.ps1",
                        "validExitCodes": [0,3010]
                    },
                    {
                        "type": "PowerShell",
                        "name": "Install R  Statistical Computing",
                        "runElevated": true,
                        "runAsSystem": true,
                        "scriptUri": "https://aibdev.blob.core.windows.net/scripts/Install-R.ps1",
                        "validExitCodes": [0,3010]
                    },
                    {
                        "type": "PowerShell",
                        "name": "Install HiediSQL",
                        "runElevated": true,
                        "runAsSystem": true,
                        "scriptUri": "https://aibdev.blob.core.windows.net/scripts/Install-HeidiSQL.ps1",
                        "validExitCodes": [0,3010]
                    },
                    {
                        "type": "PowerShell",
                        "name": "Install AdobeCampaignClassic7",
                        "runElevated": true,
                        "runAsSystem": true,
                        "scriptUri": "https://aibdev.blob.core.windows.net/scripts/Install-AdobeCampaignClassic7.ps1",
                        "validExitCodes": [0,3010]
                    },
                    {
                        "type": "PowerShell",
                        "name": "Install WinGPG",
                        "runElevated": true,
                        "runAsSystem": true,
                        "scriptUri": "https://aibdev.blob.core.windows.net/scripts/Install-WinGPG.ps1",
                        "validExitCodes": [0,3010]
                    },
                    {
                         "type": "PowerShell",
                         "name": "Install FireFox",
                         "runElevated": true,
                         "runAsSystem": true,
                         "scriptUri": "https://aibdev.blob.core.windows.net/scripts/Install-FireFox.ps1",
                         "validExitCodes": [0,3010]
                     },
                    {
                        "type": "PowerShell",
                        "name": "Install Insomnia REST API client",
                        "runElevated": true,
                        "runAsSystem": true,
                        "scriptUri": "https://aibdev.blob.core.windows.net/scripts/Install-Insomnia.ps1",
                        "validExitCodes": [0,3010]
                    },
                    {
                        "type": "PowerShell",
                        "name": "Install (extra) Windows Enabled Features",
                        "runElevated": true,
                        "runAsSystem": true,
                        "scriptUri": "https://aibdev.blob.core.windows.net/scripts/Install-EnableWindowsFeatures.ps1",
                        "validExitCodes": [0,3010]
                    },
                    {
                        "type": "PowerShell",
                        "name": "Install psql command line tools only",
                        "runElevated": true,
                        "runAsSystem": true,
                        "scriptUri": "https://aibdev.blob.core.windows.net/scripts/Install-psql.ps1",
                        "validExitCodes": [0,3010]
                    },
                    {
                        "type": "PowerShell",
                        "name": "Install jq JSON parser",
                        "runElevated": true,
                        "runAsSystem": true,
                        "scriptUri": "https://aibdev.blob.core.windows.net/scripts/Install-jq.ps1",
                        "validExitCodes": [0,3010]
                    },
                    {
                        "type": "PowerShell",
                        "name": "Install MobaXterm",
                        "runElevated": true,
                        "runAsSystem": true,
                        "scriptUri": "https://aibdev.blob.core.windows.net/scripts/Install-MobaXterm.ps1",
                        "validExitCodes": [0,3010]
                    },
                    {
                        "type": "PowerShell",
                        "name": "Install Go",
                        "runElevated": true,
                        "runAsSystem": true,
                        "scriptUri": "https://aibdev.blob.core.windows.net/scripts/Install-Go.ps1",
                        "validExitCodes": [0,3010]
                    },
                    {
                        "type": "PowerShell",
                        "name": "Install Ruby",
                        "runElevated": true,
                        "runAsSystem": true,
                        "scriptUri": "https://aibdev.blob.core.windows.net/scripts/Install-Ruby.ps1",
                        "validExitCodes": [0,3010]
                    },
                    {
                        "type": "PowerShell",
                        "name": "Install BIND -tools only",
                        "runElevated": true,
                        "runAsSystem": true,
                        "scriptUri": "https://aibdev.blob.core.windows.net/scripts/Install-BINDtools.ps1",
                        "validExitCodes": [0,3010]
                    },
                    {
                        "type": "PowerShell",
                        "name": "Install FFMPEG",
                        "runElevated": true,
                        "runAsSystem": true,
                        "scriptUri": "https://aibdev.blob.core.windows.net/scripts/Install-FFMPEG.ps1",
                        "validExitCodes": [0,3010]
                    },
                    {
                        "type": "PowerShell",
                        "name": "Install WireShark",
                        "runElevated": true,
                        "runAsSystem": true,
                        "scriptUri": "https://aibdev.blob.core.windows.net/scripts/Install-WireShark.ps1",
                        "validExitCodes": [0,3010]
                    },
                    {
                        "type": "PowerShell",
                        "name": "CollectInstalledApps",
                        "runElevated": true,
                        "runAsSystem": true,
                        "inline": ["Get-ItemProperty HKLM:\\Software\\Wow6432Node\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\*,HKLM:\\Software\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\* | Select-Object DisplayName, DisplayVersion, Publisher, InstallDate -Unique | Where-Object {$_.DisplayName -ne \"\"} | Sort-Object -Property DisplayName | Export-CSV C:\\Comcast\\DeveloperNSE.csv -NoTypeInformation","choco install azcopy10 -y --no-progress" ,"[variables('InstalledApplicationsAzcopy')]"]           
                    },
                    {
                        "type": "WindowsRestart",
                        "restartCheckCommand": "Write-Output 'restarting post Developer apps installation'",
                        "restartTimeout": "15m"
                    },
					{
                        "type": "PowerShell",
                        "name": "Pause to fix SysPrep",
                        "runElevated": true,
                        "runAsSystem": true,
                        "inline": ["Start-Sleep -Seconds 300"]
                    }

                ],
                "distribute": [
                    {
                        "type": "SharedImage",
                        "galleryImageId": "[concat(parameters('SharedImageGalleryID'),'/images/',parameters('ImageTemplateName'))]",
                        "runOutputName": "sigOutput",
                        "artifactTags": {
                            "source": "21h1-evd-o365pp-g2",
                            "baseosimg": "21h1-evd-o365pp-g2"
                        },
                        "replicationRegions": [
                            "eastus"
                        ]
                    }
                ]
            }
        }
    ]
}